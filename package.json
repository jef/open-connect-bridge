{
  "name": "open-connect-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Forward Foresight launch monitor shots (GSPconnect or Foresight Premier) to an Open Connect v1 listener",
  "license": "MIT",
  "bin": "dist/index.js",
  "type": "module",
  "main": "build/desktop.cjs",
  "scripts": {
    "build": "tsc",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "node dist/index.js",
    "test": "tsc && vitest run",
    "package:win": "npm run package:prepare && electron-builder --win portable --x64 --publish never",
    "package:prepare": "tsc && node scripts/package.mjs",
    "package:linux": "npm run package:prepare && electron-builder --linux tar.gz --x64 --publish never",
    "package:linux:appimage": "npm run package:prepare && electron-builder --linux AppImage --x64 --publish never",
    "package:mac": "npm run package:prepare && electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "volta": {
    "node": "26.13.0"
  },
  "build": {
    "appId": "com.openconnectbridge.desktop",
    "productName": "Open Connect Bridge",
    "asar": true,
    "files": [
      "build/desktop.cjs",
      "build/preload.cjs",
      "build/ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build/release"
    },
    "win": {
      "target": "portable",
      "artifactName": "open-connect-bridge.exe"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "artifactName": "open-connect-bridge-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "target": "AppImage",
      "artifactName": "open-connect-bridge-${version}-linux-${arch}.${ext}"
    }
  }
}
