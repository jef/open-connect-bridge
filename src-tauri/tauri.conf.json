{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Connect Bridge",
  "version": "1.0.0",
  "identifier": "com.openconnectbridge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Connect Bridge",
        "width": 1040,
        "height": 780,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
